# ESP32-C3 RISC-V

set shell := ["zsh", "-uc"]
set dotenv-load := true

profile      := "release"        # release or debug
defmt_level  := "trace"          # default DEFMT_LOG
default_bin  := "total"          # fallback

# List the recipes
default:
    @just --list

# ------------------------------------------------------------
# BUILD / RUN
# ------------------------------------------------------------

# Build one binary, not the whole repo
build bin=default_bin profile=profile:
    DEFMT_LOG="${DEFMT_LOG:-{{defmt_level}}}" \
    cargo build --{{profile}} --bin {{bin}}

# Flash and monitor, through the runner in .cargo/config.toml
run bin=default_bin profile=profile:
    DEFMT_LOG="${DEFMT_LOG:-{{defmt_level}}}" \
    cargo run --{{profile}} --bin {{bin}}

# Examples:
#   just run                # -> total
#   just run dual_run_1
#   DEFMT_LOG=debug just run stress_all

# ------------------------------------------------------------
# CLEAN / LINT
# ------------------------------------------------------------

clean:
    cargo clean

# cargo fmt + clippy -D warnings
fmt:
    cargo fmt
    cargo clippy -- -D warnings
